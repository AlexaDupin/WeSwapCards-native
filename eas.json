{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "22.16.0",
      "environment": "development",
      "env": {
        "APP_ENV": "development",
        "HUSKY": "0"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "node": "22.16.0",
      "environment": "preview",
      "env": {
        "APP_ENV": "preview"
      },
      "android": {
        "buildType": "apk"
      },
      "channel": "preview"
    },
    "production": {
      "node": "22.16.0",
      "environment": "production",
      "env": {
        "APP_ENV": "production"
      },
      "autoIncrement": true,
      "channel": "production"
    },
    "production-test": {
      "node": "22.16.0",
      "environment": "production",
      "env": {
        "APP_ENV": "production"
      },
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "production"
    }
  },
  "submit": {
    "production": {}
  }
}
